# Copy this file to .env before starting Docker Compose. Do not use these values outside local development.
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000

POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_PORT=5432

REDIS_PASSWORD=change-me-local-redis-password
REDIS_PORT=6379

# Generate distinct long random values, for example: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
PAYMENT_PROVIDER_PORT=8080
